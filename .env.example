# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://search:search@localhost:5432/search

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=documents

# Search tuning
# Number of documents a search request returns.
SEARCH_RESULT_SIZE=20
# Candidate ids pulled from ES (by relevance) before ordering by created_date.
SEARCH_CANDIDATE_POOL=1000
